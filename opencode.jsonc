{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "scai-orchestrator": {
      "description": "SCAI orchestrator — single-cell analysis through specialist agents",
      "mode": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow"
        }
      },
      "prompt": "{file:agents/scai-orchestrator/INSTRUCTIONS.md}",
      "tools": {
        "bash": true,
        "delegate": true,
        "delegation_list": true,
        "delegation_read": true,
        "edit": true,
        "read": true,
        "write": true
      }
    }
  },
  "skills": {
    "paths": ["./skills"]
  }
}
